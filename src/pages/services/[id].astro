---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Blob from "../../components/Blob.astro";
import { company } from "../../site";

export async function getStaticPaths() {
  const services = await getCollection("services", ({ data }) => data.published);
  return services.map((s) => ({ params: { id: s.id }, props: { service: s } }));
}
const { service } = Astro.props;
const { Content } = await render(service);
const d = service.data;
---
<Base title={d.name} description={d.catch} theme={d.color} shape="round">
  <section class="svc-hero">
    <div class="wrap svc-hero-inner">
      <div>
        <span class="status">{d.status}</span>
        <h1>{d.name}</h1>
        <p class="catch">{d.catch}</p>
        {d.url && <a class="btn" href={d.url} target="_blank" rel="noopener">サービスサイトへ</a>}
      </div>
      <Blob color="var(--paint)" variant={1} class="hero-paint" />
    </div>
  </section>

  <section class="section">
    <div class="narrow prose">
      <Content />
    </div>
  </section>

  <section class="operator">
    <div class="narrow">
      <p class="muted">運営会社</p>
      <p><a href="/company/">{company.name}</a>　{company.address}</p>
      <p class="muted small">このサービスについてのお問い合わせは、<a href="/contact/">お問い合わせ</a>からご連絡ください。</p>
    </div>
  </section>
</Base>

<style>
  .svc-hero { background: var(--soft); padding: 72px 0; overflow: hidden; }
  .svc-hero-inner { display: grid; grid-template-columns: 1fr 280px; gap: 40px; align-items: center; }
  .status { display: inline-block; font-size: 13px; font-weight: 700; padding: 2px 14px; border-radius: 99px; background: var(--canvas); color: var(--deep); }
  .svc-hero h1 { font-size: clamp(30px, 4vw, 46px); margin-top: 16px; }
  .catch { font-size: 19px; margin: 16px 0 32px; }
  :global(.hero-paint) { width: 100%; }
  .operator { border-top: 1px solid var(--rule); padding: 40px 0 64px; font-size: 15px; }
  .operator .small { margin-top: 8px; font-size: 13px; }
  @media (max-width: 760px) {
    .svc-hero-inner { grid-template-columns: 1fr; }
    :global(.hero-paint) { width: 120px; order: -1; }
  }
</style>
