---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Crayon from "../../components/sketch/Crayon.astro";
import PencilRule from "../../components/sketch/PencilRule.astro";
import { company } from "../../site";

export async function getStaticPaths() {
  const services = await getCollection("services", ({ data }) => data.published);
  return services.map((s) => ({ params: { id: s.id }, props: { service: s } }));
}
const { service } = Astro.props;
const { Content } = await render(service);
const d = service.data;
const crayonColor = { orange: "var(--crayon-orange)", red: "var(--crayon-red)", yellow: "var(--crayon-yellow)", blue: "var(--pencil)" } as const;
---
<Base title={d.name} description={d.catch}>
  <div class="sketch-page crayon-page">
    <section class="hero">
      <div class="wrap hero-inner">
        <div>
          <p class="back"><a href="/services/">自社サービス</a></p>
          <span class="status">{d.status}</span>
          <h1 class="crayon-font">{d.name}</h1>
          <p class="catch">{d.catch}</p>
          {d.url && <a class="btn-crayon" href={d.url} target="_blank" rel="noopener">サービスサイトへ</a>}
        </div>
        <Crayon color={crayonColor[d.color]} strength={2} seed={131} class="hero-blob" />
      </div>
    </section>

    <section class="block">
      <div class="wrap"><div class="prose"><Content /></div></div>
    </section>

    <section class="operator">
      <div class="wrap">
        <PencilRule strength={1} seed={141} />
        <p class="op-label pencil-font">運営会社</p>
        <p><a class="link-pencil" href="/company/">{company.name}</a></p>
        <p class="small">このサービスについてのお問い合わせは、<a class="link-pencil" href="/contact/">お問い合わせ</a>からご連絡ください。</p>
      </div>
    </section>
  </div>
</Base>

<style>
  .crayon-page { font-family: var(--font-crayon); }
  .hero { padding: 56px 0 24px; }
  .hero-inner { display: grid; grid-template-columns: 1fr 280px; gap: 40px; align-items: center; }
  .back a { font-size: 14px; color: var(--sub); text-decoration: none; }
  .back a::before { content: "‹ "; }
  .status { display: inline-block; margin-top: 20px; font-size: 13px; font-weight: 700; padding: 2px 14px; border-radius: 99px; background: #fbefe2; color: #8a3f10; }
  h1 { font-size: clamp(32px, 4.4vw, 50px); margin-top: 14px; letter-spacing: 0.04em; }
  .catch { font-size: 19px; margin: 14px 0 32px; color: #3d4148; }
  .btn-crayon { display: inline-block; padding: 12px 30px; border-radius: 99px; background: var(--crayon-orange); color: #fff; font-weight: 700; text-decoration: none; }
  .hero :global(.hero-blob) { width: 100%; }
  .prose { max-width: 720px; line-height: 2.05; }
  .prose :global(h2) { display: inline-block; border-left: 0; padding: 0 4px; font-family: var(--font-crayon); background: linear-gradient(transparent 60%, rgba(239, 138, 58, .38) 60%); }
  .operator { padding: 24px 0 72px; font-size: 15px; }
  .operator :global(.pencil-rule) { max-width: 720px; margin-bottom: 24px; }
  .op-label { font-size: 16px; color: var(--pencil); }
  .small { margin-top: 8px; font-size: 13px; color: var(--sub); }
  @media (max-width: 760px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero :global(.hero-blob) { width: 120px; order: -1; }
  }
</style>
