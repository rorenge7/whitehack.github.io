---
import Base from "../layouts/Base.astro";
---
<Base title="ページが見つかりません">
  <section class="section">
    <div class="narrow">
      <h1 style="font-size:32px">このページは見つかりません</h1>
      <p class="muted" style="margin-top:16px">URLが変わったか、ページが削除された可能性があります。</p>
      <p style="margin-top:32px"><a class="btn" href="/">トップページへ</a></p>
    </div>
  </section>
</Base>
