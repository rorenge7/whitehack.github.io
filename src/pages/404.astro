---
import Base from "../layouts/Base.astro";
import SketchHead from "../components/sketch/SketchHead.astro";
import PencilButton from "../components/sketch/PencilButton.astro";
---
<Base title="ページが見つかりません">
  <div class="sketch-page">
    <SketchHead title="このページは見つかりません" lead="URLが変わったか、ページが削除された可能性があります。" />
    <section class="block" style="padding-top:32px">
      <div class="wrap"><PencilButton href="/">トップページへ</PencilButton></div>
    </section>
  </div>
</Base>
