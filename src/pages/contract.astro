---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Blob from "../components/Blob.astro";
import Cta from "../components/Cta.astro";
import { company, contractServices, contractLead, profile } from "../site";

const works = (await getCollection("works", ({ data }) => data.published)).sort((a, b) => a.data.order - b.data.order || +b.data.date - +a.data.date).slice(0, 3);

const services = contractServices;
const steps = [
  { title: "ヒアリング", text: "課題、実現したいこと、予算と時期の感触を伺います。" },
  { title: "ご提案・お見積り", text: "開発範囲と進め方を整理し、作業ごとの内訳つきで見積りをお出しします。" },
  { title: "設計", text: "画面・データ・機能を仕様書にまとめ、合意してから開発に入ります。" },
  { title: "開発・テスト", text: "途中段階でも動く画面でご確認いただきながら進めます。" },
  { title: "公開・保守", text: "公開後も、不具合対応や機能追加を継続してお引き受けします。" },
];
---
<Base title="受託開発" description="株式会社白白の受託開発。Webアプリ・業務システム・Webサイトを、要件整理から保守まで一貫して開発します。" theme="blue" shape="square">
  <section class="page-head">
    <div class="wrap">
      <p class="kicker">企業の方へ</p>
      <h1>受託開発</h1>
      <p class="lead">{contractLead}</p>
    </div>
    <Blob color="var(--blue)" variant={0} class="head-paint" />
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section-title">対応できること</h2>
      <div class="svc-grid">
        {services.map((s) => (
          <article class="svc">
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            {s.note && <p class="note">{s.note}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-alt">
    <div class="wrap">
      <h2 class="section-title">ご依頼の流れ</h2>
      <ol class="steps">
        {steps.map((s, i) => (
          <li><span class="n">{String(i + 1).padStart(2, "0")}</span><h3>{s.title}</h3><p>{s.text}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap profile">
      <div>
        <h2 class="section-title">担当者</h2>
        <p class="name">{company.representative}</p>
        <p class="muted">{company.title}</p>
      </div>
      <div>
        <p class="profile-lead">ご相談の窓口から設計・開発まで、代表が直接担当します。伝えた内容がそのまま形になり、判断も速く進みます。</p>
        <p style="margin-top:20px">{profile.summary}</p>
        <dl class="data-table" style="margin-top:28px">
          <div><dt>主な資格</dt><dd>{profile.qualifications.map((q) => <>{q}<br /></>)}</dd></div>
          <div><dt>主な技術</dt><dd>{profile.skills}</dd></div>
        </dl>
        <p style="margin-top:20px"><a class="text-link" href="/company/#profile">経歴をくわしく見る</a></p>
      </div>
    </div>
  </section>

  {works.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="section-title-row">
          <h2 class="section-title">実績</h2>
          <a class="text-link" href="/works/">すべて見る</a>
        </div>
        <ul class="work-cards">
          {works.map((w) => (
            <li><a href={`/works/${w.id}/`}><span class="cat">{w.data.category}</span><h3>{w.data.title}</h3><p class="muted">{[w.data.client, w.data.period].filter(Boolean).join("／")}</p></a></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <Cta title="開発のご相談" text="仕様が固まっていない段階でも構いません。分かる範囲でお知らせください。" />
</Base>

<style>
  .page-head { padding-right: 0; }
  :global(.head-paint) { position: absolute; right: max(4vw, 24px); top: 50%; translate: 0 -50%; width: clamp(120px, 18vw, 240px); opacity: .95; }
  .svc-grid { display: grid; grid-template-columns: repeat(3, 1fr); row-gap: 8px; gap: 0; border-top: 2px solid var(--deep); }
  .svc { padding: 32px 28px 8px 0; }
  .svc + .svc { padding-left: 28px; border-left: 1px solid var(--rule); }
  .svc h3 { font-size: 20px; }
  .svc p { margin-top: 12px; color: var(--sub); font-size: 15px; }
  .svc .note { margin-top: 12px; font-size: 13px; color: var(--deep); }
  .svc li::marker { color: var(--paint); }

  .steps { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
  .steps li { background: var(--canvas); border-top: 3px solid var(--paint); padding: 24px 20px; }
  .steps .n { font-weight: 700; color: var(--deep); font-size: 14px; letter-spacing: 0.1em; font-variant-numeric: tabular-nums; }
  .steps h3 { font-size: 17px; margin-top: 8px; }
  .steps p { font-size: 14px; color: var(--sub); margin-top: 8px; line-height: 1.8; }

  .profile { display: grid; grid-template-columns: 4fr 8fr; gap: 48px; }
  .profile .section-title { margin-bottom: 20px; }
  .name { font-size: 28px; font-weight: 700; letter-spacing: 0.16em; }
  .profile-lead { font-size: 18px; }

  .work-cards { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .work-cards a { display: block; height: 100%; padding: 24px; border: 1px solid var(--rule); border-radius: 4px; text-decoration: none; }
  .work-cards a:hover { border-color: var(--paint); }
  .work-cards .cat { font-size: 12px; font-weight: 700; color: var(--deep); }
  .work-cards h3 { font-size: 17px; margin: 6px 0 8px; }
  .work-cards p { font-size: 14px; }

  @media (max-width: 880px) {
    :global(.head-paint) { width: 96px; top: 24px; translate: none; opacity: .9; }
    .svc-grid, .profile, .work-cards { grid-template-columns: 1fr; }
    .svc, .svc + .svc { padding: 24px 0; border-left: none; }
    .svc + .svc { border-top: 1px solid var(--rule); }
    .steps { grid-template-columns: 1fr; }
  }
</style>
