---
import Base from "../layouts/Base.astro";
import Cta from "../components/Cta.astro";
import { company, profile } from "../site";

const todo = "【要記入】";
---
<Base title="会社概要" description="株式会社白白の会社概要。所在地、設立、資本金、法人番号、事業内容。">
  <section class="page-head">
    <div class="wrap">
      <h1>会社概要</h1>
    </div>
  </section>

  <section class="section">
    <div class="narrow">
      <dl class="data-table">
        <div><dt>商号</dt><dd>{company.name}（{company.kana}）<br /><span class="muted">{company.en}</span></dd></div>
        <div><dt>代表者</dt><dd>{company.title}　{company.representative}</dd></div>
        <div><dt>所在地</dt><dd>
          {company.postalCode ? `〒${company.postalCode}` : <span class="todo">〒{todo}</span>}<br />
          {company.address}{company.address === "東京都新宿区" && <span class="todo">{todo}</span>}
        </dd></div>
        <div><dt>設立</dt><dd>{company.founded}</dd></div>
        <div><dt>資本金</dt><dd>{company.capital || <span class="todo">{todo}</span>}</dd></div>
        <div><dt>法人番号</dt><dd>{company.corporateNumber || <span class="todo">{todo}</span>}</dd></div>
        <div><dt>事業内容</dt><dd>{company.business.map((b) => <>{b}<br /></>)}</dd></div>
      </dl>
    </div>
  </section>

  <section class="section-alt" id="profile">
    <div class="narrow">
      <h2 class="section-title">代表プロフィール</h2>
      <p class="name">{company.title}　{company.representative}</p>
      <div class="prose" style="margin-top:24px">
        <p>{profile.summary}</p>
        {profile.history.map((h) => <p>{h}</p>)}
      </div>
      <dl class="data-table" style="margin-top:40px">
        <div><dt>主な資格</dt><dd>{profile.qualifications.map((q) => <>{q}<br /></>)}</dd></div>
        <div><dt>主な技術</dt><dd>{profile.skills}</dd></div>
      </dl>
    </div>
  </section>

  <Cta />
</Base>

<style>
  .name { font-weight: 700; letter-spacing: 0.12em; }
</style>
