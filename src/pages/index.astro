---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import HeroSketch from "../components/sketch/HeroSketch.astro";
import PencilBox from "../components/sketch/PencilBox.astro";
import PencilRule from "../components/sketch/PencilRule.astro";
import Crayon from "../components/sketch/Crayon.astro";
import { company, contractServices, contractLead, servicesComingSoon } from "../site";

const services = (await getCollection("services", ({ data }) => data.published)).sort((a, b) => a.data.order - b.data.order);
const news = (await getCollection("news", ({ data }) => data.published)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const works = (await getCollection("works", ({ data }) => data.published)).sort((a, b) => a.data.order - b.data.order || +b.data.date - +a.data.date).slice(0, 3);
const fmt = (d: Date) => d.toLocaleDateString("ja-JP", { year: "numeric", month: "2-digit", day: "2-digit" }).replaceAll("/", ".");
const crayonColor = { orange: "var(--crayon-orange)", red: "var(--crayon-red)", yellow: "var(--crayon-yellow)", blue: "var(--pencil)" } as const;

const contract = contractServices;
---
<Base>
  <div class="top">
    <!-- ===== ファーストビュー ===== -->
    <section class="hero">
      <div class="wrap hero-inner">
        <div class="hero-copy">
          <h1 class="pencil-font">白白は、<br />いくつもの色を<br />もつ会社です。</h1>
          <PencilRule strength={2} seed={101} />
          <p class="hero-lead">
            企業のシステムを設計してつくる受託開発と、暮らしに色をそえる自社サービス。
            ひとつの会社として、責任をもって運営しています。
          </p>
          <div class="hero-links">
            <a class="link-pencil" href="/contract/">受託開発について</a>
            <a class="link-crayon" href="/services/">自社サービスを見る</a>
          </div>
        </div>
        <div class="hero-art">
          <HeroSketch />
        </div>
      </div>
    </section>

    <!-- ===== 受託開発（鉛筆） ===== -->
    <section class="block">
      <div class="wrap contract">
        <div class="contract-head">
          <p class="kicker-pencil">企業の方へ</p>
          <h2 class="pencil-font">受託開発</h2>
          <p class="muted">{contractLead}</p>
          <p class="more"><a class="link-pencil" href="/contract/">受託開発について</a></p>
        </div>
        <PencilBox strength={2} seed={57}>
          <ul class="contract-list">
            {contract.map((c, i) => (
              <li>
                {i > 0 && <PencilRule strength={2} seed={60 + i} />}
                <h3 class="pencil-font">{c.title}</h3>
                <p class="muted">{c.text}</p>
              </li>
            ))}
          </ul>
        </PencilBox>
      </div>
    </section>

    <!-- ===== 自社サービス（クレヨン） ===== -->
    <section class="block block-tint">
      <div class="wrap">
        <div class="services-head">
          <h2 class="crayon-font">自社サービス</h2>
          <div class="services-underline"><Crayon shape="underline" color="var(--crayon-orange)" strength={2} seed={80} /></div>
          <p class="muted">白白が企画・開発・運営しているサービスです。</p>
        </div>
        <ul class="service-cards">
          {services.length === 0 && (
            <li>
              <div class="coming-soon">
                <Crayon color="var(--crayon-orange)" strength={2} seed={95} class="card-blob" />
                <span class="status">準備中</span>
                <h3 class="crayon-font">近日公開</h3>
                <p>{servicesComingSoon}</p>
              </div>
            </li>
          )}
          {services.map((s, i) => (
            <li>
              <a href={`/services/${s.id}/`}>
                <Crayon color={crayonColor[s.data.color]} strength={2} seed={90 + i} class="card-blob" />
                <span class="status">{s.data.status}</span>
                <h3 class="crayon-font">{s.data.name}</h3>
                <p>{s.data.catch}</p>
              </a>
            </li>
          ))}
        </ul>
        {services.length > 0 && <p class="more"><a class="link-crayon" href="/services/">すべてのサービス</a></p>}
      </div>
    </section>

    <!-- ===== 実績・お知らせ（鉛筆の罫線） ===== -->
    <section class="block">
      <div class="wrap two-col">
        <div>
          <h2 class="pencil-font small-title">実績</h2>
          <ul class="ruled">
            {works.map((w, i) => (
              <li>
                <PencilRule strength={2} seed={120 + i} />
                <a href={`/works/${w.id}/`}><span class="cat">{w.data.category}</span><span class="ttl">{w.data.title}</span><span class="muted sm">{w.data.client ?? w.data.category}</span></a>
              </li>
            ))}
          </ul>
          <p class="more"><a class="link-pencil" href="/works/">実績一覧</a></p>
        </div>
        <div>
          <h2 class="pencil-font small-title">お知らせ</h2>
          <ul class="ruled">
            {news.map((n, i) => (
              <li>
                <PencilRule strength={2} seed={140 + i} />
                <a href={`/news/${n.id}/`} class="news-row"><time datetime={n.data.date.toISOString()}>{fmt(n.data.date)}</time><span class="ttl">{n.data.title}</span></a>
              </li>
            ))}
          </ul>
          <p class="more"><a class="link-pencil" href="/news/">お知らせ一覧</a></p>
        </div>
      </div>
    </section>

    <!-- ===== 会社情報（信用の確認用） ===== -->
    <section class="block block-tint">
      <div class="wrap company">
        <h2 class="pencil-font small-title">会社情報</h2>
        <dl class="company-table">
          {[
            ["商号", `${company.name}（${company.kana}）`],
            ["代表者", company.representative],
            ["所在地", `${company.postalCode ? `〒${company.postalCode} ` : ""}${company.address}`],
            ["設立", company.founded],
          ].map(([k, v], i) => (
            <div>
              {i > 0 && <PencilRule strength={2} seed={160 + i} />}
              <div class="row"><dt>{k}</dt><dd>{v}</dd></div>
            </div>
          ))}
        </dl>
        <p class="more"><a class="link-pencil" href="/company/">会社概要</a></p>
      </div>
    </section>

    <!-- ===== お問い合わせ ===== -->
    <section class="block">
      <div class="wrap">
        <PencilBox strength={2} seed={180}>
          <div class="contact">
            <div>
              <h2 class="pencil-font">ご相談・お問い合わせ</h2>
              <p class="muted">開発のご依頼、サービスについてのご質問、お取引のご相談などを受け付けています。</p>
            </div>
            <a class="btn-ink" href="/contact/">お問い合わせへ</a>
          </div>
        </PencilBox>
      </div>
    </section>
  </div>
</Base>

<style>
  .top { background: var(--paper-warm); font-family: var(--font-pencil); }
  .pencil-font { font-family: var(--font-pencil-head); font-weight: 400; }
  .hero h1.pencil-font { font-family: var(--font-pencil); font-weight: 600; }
  .crayon-font { font-family: var(--font-crayon); font-weight: 500; }
  .block-tint:has(.service-cards) { font-family: var(--font-crayon); }
  .muted { color: var(--sub); }
  .sm { font-size: 14px; }
  .more { margin-top: 28px; }

  .link-pencil, .link-crayon { font-weight: 700; text-decoration: none; padding-bottom: 3px; }
  .link-pencil { color: var(--pencil); border-bottom: 1.5px solid var(--pencil); }
  .link-crayon { color: #b4561a; border-bottom: 3px solid var(--crayon-orange); border-radius: 2px; }
  .link-pencil:hover, .link-crayon:hover { opacity: .75; }

  /* hero */
  .hero { padding: 80px 0 88px; }
  .hero-inner { display: grid; grid-template-columns: 5fr 6fr; gap: 56px; align-items: center; }
  .hero h1 { font-size: clamp(34px, 4.2vw, 52px); line-height: 1.55; letter-spacing: 0.06em; }
  .hero-copy :global(.pencil-rule) { width: 80%; margin: 22px 0 0; }
  .hero-lead { margin-top: 24px; color: var(--sub); max-width: 28em; }
  .hero-links { display: flex; gap: 28px; flex-wrap: wrap; margin-top: 32px; }

  /* sections */
  .block { padding: 96px 0; }
  .block-tint { background: #faf6ee; }
  h2 { font-size: clamp(26px, 3vw, 34px); letter-spacing: 0.06em; }
  .small-title { font-size: 26px; margin-bottom: 12px; }

  .contract { display: grid; grid-template-columns: 5fr 7fr; gap: 64px; align-items: start; }
  .kicker-pencil { color: var(--pencil); font-weight: 700; font-size: 14px; margin-bottom: 8px; }
  .contract-head .muted { margin-top: 20px; }
  .contract-list { list-style: none; padding: 0; }
  .contract-list h3 { font-size: 21px; }
  .contract-list p { font-size: 15px; margin-top: 4px; }
  .contract-list :global(.pencil-rule) { margin: 18px 0; }

  .services-head { margin-bottom: 40px; }
  .services-underline { width: 190px; margin: 2px 0 12px; }
  .service-cards { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
  .service-cards .coming-soon, .service-cards a { position: relative; display: block; height: 100%; padding: 28px; border-radius: 24px; background: #fff; text-decoration: none; overflow: hidden; box-shadow: inset 0 0 0 1px #ece6da; transition: transform .2s; }
  .service-cards .coming-soon { grid-column: 1 / -1; max-width: 640px; }
  .service-cards a:hover { transform: translateY(-3px); }
  .service-cards :global(.card-blob) { position: absolute; right: -18px; top: -18px; width: 112px; }
  .status { display: inline-block; font-size: 12px; font-weight: 700; padding: 1px 12px; border-radius: 99px; background: #fbefe2; color: #8a3f10; }
  .service-cards h3 { font-size: 21px; margin-top: 36px; }
  .service-cards p { margin-top: 6px; font-size: 15px; color: var(--sub); }

  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; }
  .ruled { list-style: none; padding: 0; }
  .ruled :global(.pencil-rule) { margin: 0; }
  .ruled a { display: grid; gap: 2px; padding: 16px 0; text-decoration: none; }
  .ruled a:hover .ttl { text-decoration: underline; }
  .cat { font-size: 12px; font-weight: 700; color: var(--pencil); }
  .ttl { font-weight: 700; }
  .news-row { grid-template-columns: 110px 1fr; gap: 16px !important; }
  .news-row time { color: var(--sub); font-size: 14px; font-variant-numeric: tabular-nums; }

  .company-table { margin: 0; max-width: 760px; }
  .company-table :global(.pencil-rule) { margin: 0; }
  .row { display: grid; grid-template-columns: 180px 1fr; padding: 16px 0; }
  .row dt { color: var(--sub); }

  .contact { display: flex; align-items: center; justify-content: space-between; gap: 32px; flex-wrap: wrap; padding: 8px 4px; }
  .contact h2 { font-size: 28px; }
  .contact .muted { margin-top: 8px; }
  .btn-ink { display: inline-block; padding: 14px 28px; background: var(--ink); color: #fff; font-weight: 700; text-decoration: none; }
  .btn-ink:hover { background: var(--pencil); }

  @media (max-width: 880px) {
    .hero { padding: 48px 0 56px; }
    .hero-inner, .contract, .two-col { grid-template-columns: 1fr; gap: 40px; }
    .block { padding: 72px 0; }
    .row { grid-template-columns: 1fr; gap: 2px; }
    .news-row { grid-template-columns: 1fr; gap: 0 !important; }
  }
</style>
