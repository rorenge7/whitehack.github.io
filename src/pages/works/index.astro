---
import Base from "../../layouts/Base.astro";
import SketchHead from "../../components/sketch/SketchHead.astro";
import SketchCta from "../../components/sketch/SketchCta.astro";
import WorksList from "../../components/sketch/WorksList.astro";
---
<Base title="実績" description="株式会社白白の実績。お客様の困りごとを起点に取り組んできた開発の一部です。">
  <div class="sketch-page">
    <SketchHead kicker="受託開発" title="実績" lead="お客様の困りごとを起点に取り組んできた開発の一部です。" />
    <section class="block" style="padding-top:40px">
      <div class="wrap"><div style="max-width:920px">
        <WorksList />
      </div></div>
    </section>
    <SketchCta title="開発のご相談" text="似た困りごとをお持ちでしたら、お気軽にご相談ください。" />
  </div>
</Base>
