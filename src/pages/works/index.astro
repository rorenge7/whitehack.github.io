---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Cta from "../../components/Cta.astro";

const works = (await getCollection("works", ({ data }) => data.published)).sort((a, b) => a.data.order - b.data.order || +b.data.date - +a.data.date);
---
<Base title="実績" description="株式会社白白の受託開発の実績・制作事例です。" theme="blue" shape="square">
  <section class="page-head">
    <div class="wrap">
      <p class="kicker">受託開発</p>
      <h1>実績</h1>
      <p class="lead">これまでに手がけた開発の一部をご紹介します。お客様の名称は、許可をいただいたもの以外は業種のみ記載しています。</p>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <ul class="works">
        {works.map((w) => (
          <li>
            <a href={`/works/${w.id}/`}>
              <span class="cat">{w.data.category}</span>
              <h2>{w.data.title}</h2>
              <p class="muted">{[w.data.client, w.data.period].filter(Boolean).join("／")}</p>
              {w.data.stack.length > 0 && <ul class="stack">{w.data.stack.map((t) => <li>{t}</li>)}</ul>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <Cta title="開発のご相談" text="似た課題をお持ちでしたら、お気軽にご相談ください。" />
</Base>

<style>
  .works { list-style: none; padding: 0; border-top: 2px solid var(--deep); }
  .works > li > a { display: block; padding: 28px 0; border-bottom: 1px solid var(--rule); text-decoration: none; }
  .works > li > a:hover h2 { text-decoration: underline; }
  .cat { font-size: 13px; font-weight: 700; color: var(--deep); }
  .works h2 { font-size: 21px; margin: 4px 0; }
  .stack { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .stack li { font-size: 12px; padding: 1px 10px; border: 1px solid var(--rule); border-radius: 2px; color: var(--sub); }
</style>
