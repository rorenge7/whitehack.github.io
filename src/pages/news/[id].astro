---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const news = await getCollection("news", ({ data }) => data.published);
  return news.map((n) => ({ params: { id: n.id }, props: { post: n } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const date = d.date.toLocaleDateString("ja-JP", { year: "numeric", month: "long", day: "numeric" });
---
<Base title={d.title}>
  <article class="section">
    <div class="narrow">
      <p class="muted"><time datetime={d.date.toISOString()}>{date}</time>　{d.category}</p>
      <h1 class="title">{d.title}</h1>
      <div class="prose"><Content /></div>
      <p style="margin-top:64px"><a class="text-link" href="/news/" style="color:var(--ink)">お知らせ一覧へ戻る</a></p>
    </div>
  </article>
</Base>

<style>
  .title { font-size: clamp(26px, 3.4vw, 36px); margin: 12px 0 48px; padding-bottom: 32px; border-bottom: 1px solid var(--rule); }
</style>
