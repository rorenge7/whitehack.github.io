---
import Base from "../layouts/Base.astro";
import SketchHead from "../components/sketch/SketchHead.astro";
import PencilBox from "../components/sketch/PencilBox.astro";
import PencilButton from "../components/sketch/PencilButton.astro";
import Crayon from "../components/sketch/Crayon.astro";
import { company } from "../site";
---
<Base title="お問い合わせ" description="株式会社白白へのお問い合わせ。">
  <div class="sketch-page">
    <SketchHead title="お問い合わせ" lead="開発のご依頼、サービスについてのご質問、お取引や取材のご相談など、下記のフォームから受け付けています。" />

    <section class="block" style="padding-top:40px">
      <div class="wrap">
        <div class="choices">
          <PencilBox strength={2} seed={61}>
            <div class="choice">
              <h2 class="pencil-font">開発のご相談</h2>
              <p>会社名・ご担当者名、ご相談の内容、ご希望の時期・予算の目安（未定でも構いません）をお知らせください。</p>
            </div>
          </PencilBox>
          <div class="choice crayon-card">
            <Crayon color="var(--crayon-orange)" strength={2} seed={63} class="cc-blob" />
            <h2 class="crayon-font">サービスについて</h2>
            <p>どのサービスについてのお問い合わせかを、本文に書き添えてください。</p>
          </div>
        </div>

        <div class="action">
          <PencilButton href={company.contactUrl} variant="fill" external>お問い合わせフォームを開く</PencilButton>
        </div>
        <p class="note">内容を確認のうえ、担当者からご連絡します。</p>
      </div>
    </section>
  </div>
</Base>

<style>
  .choices { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; max-width: 920px; align-items: stretch; }
  .choice { padding: 8px 4px; }
  .choice h2 { font-size: 22px; letter-spacing: 0.04em; }
  .choice p { font-size: 15px; margin-top: 10px; color: var(--sub); line-height: 1.95; }
  .crayon-card { position: relative; overflow: hidden; padding: 32px 30px; border-radius: 24px; background: #fff; box-shadow: inset 0 0 0 1px #ece6da; font-family: var(--font-crayon); }
  .crayon-card :global(.cc-blob) { position: absolute; right: -22px; top: -22px; width: 100px; }
  .crayon-card h2 { margin-top: 24px; }
  .action { margin-top: 44px; }
  .note { font-size: 13px; margin-top: 18px; color: var(--sub); max-width: 46em; }
  @media (max-width: 760px) { .choices { grid-template-columns: 1fr; } }
</style>
