---
// 各ページの見出し（鉛筆の書体と区切り線）
import PencilRule from "./PencilRule.astro";
interface Props { title: string; kicker?: string; lead?: string; crayon?: boolean; }
const { title, kicker, lead, crayon = false } = Astro.props;
---
<section class="sketch-head">
  <div class="wrap">
    {kicker && <p class="kicker">{kicker}</p>}
    <h1 class={crayon ? "crayon-font" : "pencil-font"}>{title}</h1>
    <PencilRule strength={2} seed={title.length * 7} />
    {lead && <p class="lead">{lead}</p>}
  </div>
</section>

<style>
  .sketch-head { padding: 72px 0 24px; }
  .kicker { color: var(--pencil); font-weight: 700; font-size: 14px; margin-bottom: 6px; }
  h1 { font-size: clamp(34px, 4.4vw, 52px); letter-spacing: 0.06em; line-height: 1.4; }
  .sketch-head :global(.pencil-rule) { width: min(420px, 70%); margin: 18px 0 0; }
  .lead { margin-top: 24px; color: var(--sub); max-width: 34em; }
  @media (max-width: 880px) { .sketch-head { padding: 48px 0 8px; } }
</style>
