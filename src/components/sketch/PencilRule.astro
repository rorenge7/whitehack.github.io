---
// 色鉛筆の区切り線
import { wobblyLine } from "../../lib/sketch";
interface Props { strength?: 1 | 2 | 3; color?: string; dashed?: boolean; seed?: number; }
const { strength = 2, color = "var(--pencil)", dashed = false, seed = 3 } = Astro.props;
const jitter = [0, 0.4, 0.9, 1.6][strength];
---
<svg class="pencil-rule" viewBox="0 0 400 8" preserveAspectRatio="none" aria-hidden="true">
  <path d={wobblyLine(1, 4, 399, 4, jitter, seed)} fill="none" stroke={color} stroke-width="1.2" stroke-linecap="round" vector-effect="non-scaling-stroke" stroke-dasharray={dashed ? "4 4" : undefined} opacity=".85" />
  <path d={wobblyLine(3, 4.6, 396, 4.4, jitter, seed + 5)} fill="none" stroke={color} stroke-width=".6" stroke-linecap="round" vector-effect="non-scaling-stroke" opacity=".4" />
</svg>

<style>
  .pencil-rule { display: block; width: 100%; height: 8px; margin: 14px 0; }
</style>
