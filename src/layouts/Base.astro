---
import "../styles/global.css";
import { company, nav } from "../site";
import PencilButton from "../components/sketch/PencilButton.astro";

interface Props {
  title?: string;
  description?: string;
  theme?: "ink" | "blue" | "red" | "orange" | "yellow";
  shape?: "square" | "round";
}
const {
  title,
  description = "あなたの色で、描きます。株式会社白白（しらしろ）は、お客様の困りごとを起点に、事業の色に合わせて仕組みを描き、形にしてきた会社です。",
  theme = "ink",
  shape = "square",
} = Astro.props;

const pageTitle = title ? `${title}｜${company.name}` : `${company.name}（${company.kana}）｜あなたの色で、描きます。`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={company.name} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL("/og.png", Astro.site)} />
  <meta property="og:locale" content="ja_JP" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Zen+Kaku+Gothic+New:wght@400;500;700&family=Klee+One:wght@400;600&family=Kiwi+Maru:wght@400;500&family=Zen+Kurenaido&display=swap" rel="stylesheet" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    name: company.name,
    alternateName: company.en,
    url: Astro.site,
    logo: new URL("/apple-touch-icon.png", Astro.site),
    founder: { "@type": "Person", name: company.representative },
    address: { "@type": "PostalAddress", addressCountry: "JP", addressRegion: "東京都", addressLocality: "新宿区" },
  })} />
</head>
<body data-theme={theme} data-shape={shape}>
  <a class="skip-link" href="#main">本文へスキップ</a>
  <header class="site-header">
    <div class="wrap">
      <a class="logo" href="/" aria-label={`${company.name} トップへ`}>
        <img src="/favicon.svg" alt="" width="32" height="32" />
        <span>白白<small> SHIRASHIRO</small></span>
      </a>
      <button class="menu-toggle" aria-expanded="false" aria-controls="gnav">メニュー</button>
      <nav class="gnav" id="gnav" aria-label="メインメニュー">
        {nav.map((n) => (
          <a href={n.href} aria-current={path.startsWith(n.href) ? "page" : undefined}>{n.label}</a>
        ))}
        <span class="gnav-contact-wrap"><PencilButton href="/contact/" variant="fill" small>お問い合わせ</PencilButton></span>
      </nav>
    </div>
  </header>

  <main id="main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div>
        <a class="logo" href="/"><img src="/favicon.svg" alt="" width="28" height="28" /><span>{company.name}</span></a>
        <div class="footer-palette" aria-hidden="true">
          <span style="background:var(--blue)"></span><span style="background:var(--red)"></span><span style="background:var(--orange)"></span><span style="background:var(--yellow)"></span>
        </div>
      </div>
      <nav class="footer-nav" aria-label="フッターメニュー">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        <a href="/contact/">お問い合わせ</a>
        <a href="/privacy/">プライバシーポリシー</a>
      </nav>
      <p class="copyright">© 2026 {company.en}</p>
    </div>
  </footer>

  <script>
    const btn = document.querySelector(".menu-toggle");
    const nav = document.getElementById("gnav");
    btn?.addEventListener("click", () => {
      const open = nav?.classList.toggle("open");
      btn.setAttribute("aria-expanded", String(!!open));
      btn.textContent = open ? "閉じる" : "メニュー";
    });
  </script>
</body>
</html>
